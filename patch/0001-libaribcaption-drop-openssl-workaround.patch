From dde590c2481c2dc511ae1a6d2374f2926e80ca27 Mon Sep 17 00:00:00 2001
From: zhongfly <11155705+zhongfly@users.noreply.github.com>
Date: Tue, 6 Oct 2026 20:50:48 +0800
Subject: [PATCH] libaribcaption: drop openssl workaround

fixed in https://github.com/xqq/libaribcaption/commit/6c3b4f361bc8f65b34497ba0d123c5aea6f9ed84
---
 packages/libaribcaption.cmake | 3 ---
 1 file changed, 3 deletions(-)

diff --git a/packages/libaribcaption.cmake b/packages/libaribcaption.cmake
index 81016b49..304910bd 100644
--- a/packages/libaribcaption.cmake
+++ b/packages/libaribcaption.cmake
@@ -2,7 +2,6 @@ ExternalProject_Add(libaribcaption
     DEPENDS
         fontconfig
         freetype2
-        openssl
     GIT_REPOSITORY https://github.com/xqq/libaribcaption.git
     SOURCE_DIR ${SOURCE_LOCATION}
     GIT_CLONE_FLAGS "--filter=tree:0"
@@ -20,8 +19,6 @@ ExternalProject_Add(libaribcaption
         -DARIBCC_NO_RTTI=ON
         -DARIBCC_USE_FONTCONFIG=ON
         -DARIBCC_USE_FREETYPE=ON
-        "-DCMAKE_C_FLAGS='-DHAVE_OPENSSL=1'"
-        "-DCMAKE_CXX_FLAGS='-DHAVE_OPENSSL=1'"
     BUILD_COMMAND ${EXEC} ninja -C <BINARY_DIR>
     INSTALL_COMMAND ${EXEC} ninja -C <BINARY_DIR> install
     LOG_DOWNLOAD 1 LOG_UPDATE 1 LOG_CONFIGURE 1 LOG_BUILD 1 LOG_INSTALL 1
-- 
2.45.2.windows.1

