From ec7ac7eb49660cdcfdd08d03a7e5ab89dd04a4a1 Mon Sep 17 00:00:00 2001
From: zhongfly <11155705+zhongfly@users.noreply.github.com>
Date: Fri, 4 Sep 2026 02:19:36 +0800
Subject: [PATCH] curl: fix build with current libssh

Apply a curl patch that includes libssh/scp.h after libssh moved the SCP declarations out of libssh.h.
---
 ...0001-libssh-include-scp-declarations.patch | 26 +++++++++++++++++++
 packages/curl.cmake                           |  2 +-
 2 files changed, 27 insertions(+), 1 deletion(-)
 create mode 100644 packages/curl-0001-libssh-include-scp-declarations.patch

diff --git a/packages/curl-0001-libssh-include-scp-declarations.patch b/packages/curl-0001-libssh-include-scp-declarations.patch
new file mode 100644
index 0000000..a444ce0
--- /dev/null
+++ b/packages/curl-0001-libssh-include-scp-declarations.patch
@@ -0,0 +1,26 @@
+From b69e4fb512263dc53f75869151c06617ddba4e80 Mon Sep 17 00:00:00 2001
+From: zhongfly <11155705+zhongfly@users.noreply.github.com>
+Date: Mon, 14 Sep 2026 00:14:40 +0000
+Subject: [PATCH] libssh: include SCP declarations
+
+libssh moved its SCP API declarations from libssh.h to scp.h in
+9c26d881fc58e35a5ff588d5e25d9492ad9fe915.
+---
+ lib/vssh/ssh.h | 1 +
+ 1 file changed, 1 insertion(+)
+
+diff --git a/lib/vssh/ssh.h b/lib/vssh/ssh.h
+index b1071419fd..23d0f7d538 100644
+--- a/lib/vssh/ssh.h
++++ b/lib/vssh/ssh.h
+@@ -33,6 +33,7 @@ extern const struct Curl_protocol Curl_protocol_scp;
+ 
+ #ifdef USE_LIBSSH2
+ #include <libssh2.h>
++#include <libssh/scp.h>
+ #include <libssh2_sftp.h>
+ #elif defined(USE_LIBSSH)
+ /* in 0.10.0 or later, ignore deprecated warnings */
+-- 
+2.55.0
+
diff --git a/packages/curl.cmake b/packages/curl.cmake
index bda7d40..9e2130b 100644
--- a/packages/curl.cmake
+++ b/packages/curl.cmake
@@ -14,7 +14,7 @@ ExternalProject_Add(curl
     SOURCE_DIR ${SOURCE_LOCATION}
     GIT_CLONE_FLAGS "--filter=tree:0"
     GIT_CLONE_POST_COMMAND "sparse-checkout set --no-cone /* !tests !docs"
-    PATCH_COMMAND ""
+    PATCH_COMMAND ${EXEC} git am --3way ${CMAKE_CURRENT_SOURCE_DIR}/curl-*.patch
     UPDATE_COMMAND ""
     CONFIGURE_COMMAND ${EXEC} ${CMAKE_COMMAND} -H<SOURCE_DIR> -B<BINARY_DIR>
         -G Ninja
-- 
2.45.2.windows.1

