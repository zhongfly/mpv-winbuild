From: zhongfly <11155705+zhongfly@users.noreply.github.com>
Date: Mon, 9 Nov 2026 10:34:35 +0800
Subject: [PATCH] libvpl: remove patch

libvpl commit 412c5cffe3022d5ebb8a955c3b30afe7bd2e3929 resolved this issue
---
 ...-0001-fix-mingw-secure-string-macros.patch | 19 -------------------
 packages/libvpl.cmake                         |  1 -
 2 files changed, 20 deletions(-)
 delete mode 100644 packages/libvpl-0001-fix-mingw-secure-string-macros.patch

diff --git a/packages/libvpl-0001-fix-mingw-secure-string-macros.patch b/packages/libvpl-0001-fix-mingw-secure-string-macros.patch
deleted file mode 100644
index 780e99f2..00000000
--- a/packages/libvpl-0001-fix-mingw-secure-string-macros.patch
+++ /dev/null
@@ -1,19 +0,0 @@
-From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
-From: zhongfly <11155705+zhongfly@users.noreply.github.com>
-Date: Sun, 13 Sep 2026 13:29:32 +0800
-Subject: [PATCH] Fix MinGW secure string macro conflicts
-
-MinGW provides wcscpy_s and wcscat_s. Restrict the compatibility macros to
-old MSVC so they do not break calls in newer MinGW Windows headers.
----
- libvpl/src/windows/mfx_dispatcher_defs.h | 2 +-
- 1 file changed, 1 insertion(+), 1 deletion(-)
-
-diff --git a/libvpl/src/windows/mfx_dispatcher_defs.h b/libvpl/src/windows/mfx_dispatcher_defs.h
-index 38fd221..a23f1ce 100644
---- a/libvpl/src/windows/mfx_dispatcher_defs.h
-+++ b/libvpl/src/windows/mfx_dispatcher_defs.h
-@@ -20,2 +20,2 @@
--#if _MSC_VER < 1400
-+#if defined(_MSC_VER) && _MSC_VER < 1400
-     #define wcscpy_s(to, to_size, from) \
diff --git a/packages/libvpl.cmake b/packages/libvpl.cmake
index cbe15e94..d9348575 100644
--- a/packages/libvpl.cmake
+++ b/packages/libvpl.cmake
@@ -5,7 +5,6 @@ ExternalProject_Add(libvpl
     GIT_REMOTE_NAME origin
     GIT_TAG main
     UPDATE_COMMAND ""
-    PATCH_COMMAND ${EXEC} git am --3way ${CMAKE_CURRENT_SOURCE_DIR}/libvpl-*.patch
     CONFIGURE_COMMAND ${EXEC} CONF=1 cmake -H<SOURCE_DIR> -B<BINARY_DIR>
         -G Ninja
         -DCMAKE_BUILD_TYPE=Release
